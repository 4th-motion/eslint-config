{
  "name": "@4th-motion/eslint-config",
  "description": "An easy to set up eslint configuration that can be shared between your projects.",
  "version": "2.0.1",
  "main": "index.js",
  "author": "Marco Koenen <mako@4thmotion.com>",
  "license": "MIT",
  "repository": {
    "url": "git://github.com/4th-motion/eslint-config.git",
    "type": "git"
  },
  "keywords": [
    "style guide",
    "lint",
    "eslint",
    "es6"
  ],
  "bin": {
    "4th-eslint": "bin/eslint.js",
    "4th-eslint-init": "init.js"
  },
  "scripts": {
    "fresh": "rm -rf node_modules; yarn install",
    "lint": "eslint . --color --fix"
  },
  "dependencies": {
    "@babel/core": "^7.15.8",
    "@babel/eslint-parser": "^7.15.8",
    "@eslint/eslintrc": "^3.0.0",
    "arg": "^2",
    "chalk": "^4.1.2",
    "eslint": "^9.0.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0"
  },
  "eslintConfig": {
    "extends": [
      "./index.js"
    ]
  },
  "engines": {
    "node": ">=16"
  }
}
